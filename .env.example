# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# Base URL — used for generating shareable links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cloudinary — base URL for flower images (include the version segment)
NEXT_PUBLIC_CLOUDINARY_BASE_URL=https://res.cloudinary.com/dd0wmpgoq/image/upload/v1776516279

# Sentry — get your DSN from Sentry → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Auth token for source map uploads (CI only) — create at sentry.io/settings/auth-tokens
SENTRY_AUTH_TOKEN=
